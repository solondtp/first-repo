<view class="container">
  <view class="card">
    <view class="label">状态筛选</view>
    <picker mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="picker">{{statusOptions[statusIndex]}}</view>
    </picker>
  </view>

  <view class="card">
    <view class="label">关键字</view>
    <input placeholder="客户/标题/状态" bindinput="onKeywordInput" />
  </view>

  <view class="card" wx:if="{{loading}}">加载中...</view>

  <block wx:for="{{filteredList}}" wx:key="_id">
    <view class="card" bindtap="goDetail" data-id="{{item._id}}">
      <view class="title">工单号：{{item._id}}</view>
      <view>客户：{{item.customer}}</view>
      <view>状态：{{item.status}}</view>
      <view>技术员：{{item.assignedTo || '-'}}</view>
      <view>计划日期：{{item.extra.planDate || '-'}}</view>
      <view>费用合计：{{item.expenseTotal || 0}}</view>
    </view>
  </block>
</view>
