generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ConversationStatus {
  AI_PROCESSING
  MANUAL_PENDING
  FOLLOWED_UP
  WON
  CLOSED
}

enum MessageRole {
  USER
  AI
  ADMIN
  SYSTEM
}

model ChatSession {
  id              Int                 @id @default(autoincrement())
  sessionKey      String              @unique
  sourceSite      String              @default("allctp.com")
  pagePath        String?
  country         String?
  visitorInfoJson Json?
  leadId          Int?
  status          ConversationStatus  @default(AI_PROCESSING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  messages        ChatMessage[]
  uploads         Upload[]
  lead            Lead?               @relation(fields: [leadId], references: [id])
  handovers       ManualHandoverLog[]

  @@map("chat_sessions")
}

model ChatMessage {
  id            Int       @id @default(autoincrement())
  sessionId     Int
  sessionKey    String
  role          MessageRole
  content       String    @db.Text
  aiSummary     String?
  needHuman     Boolean   @default(false)
  recommendedAction String?
  rawResponseJson Json?
  createdAt     DateTime  @default(now())
  session       ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionKey, createdAt])
  @@map("chat_messages")
}

model Lead {
  id            Int       @id @default(autoincrement())
  name          String
  company       String?
  country       String?
  whatsapp      String?
  wechat        String?
  email         String?
  machineModel  String?
  serialNumber  String?
  message       String?   @db.Text
  sessionKey    String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      ChatSession[]

  @@map("leads")
}

model Upload {
  id            Int      @id @default(autoincrement())
  sessionId     Int
  sessionKey    String
  originalName  String
  filePath      String
  mimeType      String
  size          Int
  createdAt     DateTime @default(now())
  session       ChatSession @relation(fields: [sessionId], references: [id])

  @@map("uploads")
}

model ManualHandoverLog {
  id            Int      @id @default(autoincrement())
  sessionId     Int
  sessionKey    String
  reason        String
  triggerType   String
  triggeredBy   String   @default("system")
  createdAt     DateTime @default(now())
  session       ChatSession @relation(fields: [sessionId], references: [id])

  @@map("manual_handover_logs")
}

model AdminUser {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  passwordHash  String
  displayName   String
  role          String   @default("admin")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("admin_users")
}
